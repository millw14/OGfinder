# --- Solana data providers ---
# Helius API key (https://helius.dev) — used for DAS token lookups and RPC.
# Without it, the app falls back to SOLANA_RPC_URL or the public mainnet RPC.
HELIUS_API_KEY=

# Optional standard JSON-RPC fallback when HELIUS_API_KEY is not set.
SOLANA_RPC_URL=

# Optional Birdeye API key (https://birdeye.so) for market data.
BIRDEYE_API_KEY=

# --- Site ---
# Canonical public URL, used for share links and og:image cards.
# On Railway, set this to your service domain, e.g. https://ogfinder.up.railway.app
NEXT_PUBLIC_SITE_URL=

# --- Storage ---
# Directory for the SQLite url-index database.
# On Railway, attach a volume and set this to its mount path (e.g. /data).
# Defaults to .data/ in the project root when unset.
DATA_DIR=
