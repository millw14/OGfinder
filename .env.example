# ── Shared (web + bot) ────────────────────────────────────────────
# Helius API key — creation-slot data, DAS metadata, wallet analysis.
# Works without it (public RPC fallback) but slower/less complete.
HELIUS_API_KEY=

# Optional extra RPC fallback
SOLANA_RPC_URL=

# Optional Birdeye key for the social-URL indexer
BIRDEYE_API_KEY=

# ── Web ───────────────────────────────────────────────────────────
# Public origin of the deployed site (metadata / share links)
NEXT_PUBLIC_SITE_URL=

# Telegram bot @username shown on the site (no @). Defaults to OGfinderBot.
NEXT_PUBLIC_TELEGRAM_BOT=

# ── Telegram bot service ──────────────────────────────────────────
# REQUIRED. From @BotFather. Set this in Railway → Variables — never commit it.
TELEGRAM_BOT_TOKEN=

# Website origin used for the bot's "View on OGfinder" buttons
SITE_URL=

# Webhook mode (optional — long polling is the default and needs nothing):
# TELEGRAM_USE_WEBHOOK=1
# WEBHOOK_PUBLIC_URL=https://your-bot.up.railway.app   (auto-detected on Railway)
# TELEGRAM_WEBHOOK_SECRET=

# Watchlist alerts
# WATCH_INTERVAL_SEC=300
# WATCH_ALERT_PCT=20

# Run the site's social-URL indexer inside the bot too
# BOT_ENABLE_URL_INDEXER=1
